# HireHub Backend - configuration
# Copy to .env and adjust. NEVER commit the real .env file.

# HTTP server port exposed by Spring Boot
SERVER_PORT=8090

# MySQL database connection
# Port 3309 is the host mapping published by docker-compose (127.0.0.1:3309 -> 3306).
# Only used when you run the backend outside Docker; inside Docker the app talks to db:3306.
DB_URL=jdbc:mysql://localhost:3309/HireHub?createDatabaseIfNotExist=true
DB_USERNAME=root
# Never commit a real password. Generate one locally: openssl rand -base64 24
DB_PASSWORD=<votre-mot-de-passe>

# JWT (HS512 requires a secret >= 64 characters)
# Generate your own with: openssl rand -base64 48
# NEVER commit a real secret; the application refuses to start without it.
JWT_SECRET=
# Token lifetime in milliseconds (36000000 = 10 hours)
JWT_EXPIRATION=36000000

# Allowed CORS origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Docker Compose only - root password of the MySQL container
# Required: docker compose refuses to start if it is not defined.
MYSQL_ROOT_PASSWORD=