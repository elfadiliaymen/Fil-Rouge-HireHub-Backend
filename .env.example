# HireHub Backend - configuration
# Copy to .env and adjust. NEVER commit the real .env file.

# HTTP server port exposed by Spring Boot
SERVER_PORT=8090

# MySQL database connection
DB_URL=jdbc:mysql://localhost:3306/HireHub?createDatabaseIfNotExist=true
DB_USERNAME=root
# Never commit a real password. Generate one locally: openssl rand -base64 24
DB_PASSWORD=<votre-mot-de-passe>

# JWT (HS512 requires a secret >= 64 characters)
# Generate your own with: openssl rand -base64 48
# NEVER commit a real secret; the application refuses to start without it.
JWT_SECRET=
JWT_EXPIRATION=3600000
# Set to true when serving over HTTPS so the auth cookie is only sent over TLS
JWT_COOKIE_SECURE=false

# Allowed CORS origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Docker Compose only - root password of the MySQL container
# Required: docker compose refuses to start if it is not defined.
MYSQL_ROOT_PASSWORD=